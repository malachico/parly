#!/bin/sh
# git credential helper (and GH_TOKEN for gh): a short-lived token for Parly's GitHub App, minted by the hub for this agent.
# Only this agent's id (PARLY_AGENT_ID) — never the first token under /run/parly/agents/*.
case "${1:-get}" in get|token) ;; *) exit 0 ;; esac
token="${PARLY_AGENT_TOKEN:-}"
if [ -z "$token" ] && [ -n "${PARLY_AGENT_ID:-}" ] && [ -r "/run/parly/agents/$PARLY_AGENT_ID/agent-token" ]; then
  token=$(cat "/run/parly/agents/$PARLY_AGENT_ID/agent-token")
fi
[ -n "$token" ] && [ -n "${PARLY_HUB_URL:-}" ] || exit 0
t=$(curl -sf -X POST -H "Authorization: Bearer $token" "$PARLY_HUB_URL/github/token" | jq -r '.token // empty') || exit 0
[ -n "$t" ] || exit 0
if [ "${1:-}" = get ]; then cat >/dev/null; printf 'username=x-access-token\npassword=%s\n' "$t"; else printf '%s' "$t"; fi
