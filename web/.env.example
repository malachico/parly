# Base URL of Parly (Cloud Run in production).
HUB_URL=http://localhost:8080
# Optional: hub URL for the browser and public docs when HUB_URL is docker-internal (http://hub:8080).
# HUB_PUBLIC_URL=http://localhost:8080
# Same value as the hub's HUB_PROXY_SECRET, so per-IP limits apply per visitor. Optional locally.
HUB_PROXY_SECRET=
# Set to 1 only behind a single trusted reverse proxy that appends the client IP to X-Forwarded-For; the web then trusts its last entry (never on bare self-host).
# TRUST_PROXY=0
