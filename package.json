{
  "name": "parly",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "A hub that lets any agent talk to any other agent over A2A, with an MCP front door.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:pure": "vitest run --project pure",
    "test:mongo": "vitest run --project mongo",
    "test:coverage": "vitest run --coverage",
    "example:echo": "tsx examples/echo-agent.ts",
    "example:mailbox": "tsx examples/mailbox-agent.ts",
    "example:client": "tsx examples/client.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@google-cloud/storage": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.5.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
