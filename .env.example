# Copy to .env for `npm run dev`. Deployed instances set these in their own environment instead.
# Local Mongo replica set (see docs/self-host.md):
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
# Sign-in with dev:<email> tokens; only with a localhost MONGODB_URI, never against real data.
# GOOGLE_AUTH_DEV=1
# OAuth Web client ID; enables Google sign-in.
GOOGLE_CLIENT_ID=
# Google emails with owner rights on every team (space-separated).
SUPER_ADMIN_EMAILS=
# Invite emails (optional): a Gmail account, its app password (myaccount.google.com/apppasswords), and the web app's public URL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
WEB_URL=http://localhost:3000
