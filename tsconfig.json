{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "examples", "scripts", "test", "vitest.config.ts"],
  // A test of web/ components: it needs web/'s React and JSX, which the hub's typecheck (and its npm ci) don't have.
  "exclude": ["test/liveRefresh.test.ts"]
}
